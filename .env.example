# Trend Analiz Uygulaması - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve API anahtarlarınızı girin

# Groq Cloud API Key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Model (opsiyonel, varsayılan: llama-3.3-70b-versatile)
# Güncel model listesi: https://console.groq.com/docs/models
# GROQ_MODEL=llama-3.3-70b-versatile

# Frontend'in API'ye erişebileceği originler, virgülle ayrılmış (opsiyonel)
# ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# Bir istekte kabul edilecek maksimum "konu" uzunluğu (opsiyonel)
# MAX_KONU_LENGTH=100